DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apex_authority
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=replace_with_supported_model
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Module 2 additions (all optional)
AI_PROVIDER=gemini            # gemini | mock | disabled
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1              # extra attempts after the first; hard-capped at 3
AI_RETRY_BACKOFF_SECONDS=1.0
AAR_REQUIRE_REVIEW_FOR_EXPORT=true
