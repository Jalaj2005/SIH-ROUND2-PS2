{
  "$defs": {
    "AARStatus": {
      "enum": [
        "draft",
        "reviewed",
        "exported"
      ],
      "title": "AARStatus",
      "type": "string"
    },
    "Classification": {
      "enum": [
        "fact",
        "interpretation",
        "recommendation"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Finding": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_refs"
      ],
      "title": "Finding",
      "type": "object"
    },
    "KeyObservation": {
      "properties": {
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "observation",
        "classification",
        "evidence_refs",
        "confidence"
      ],
      "title": "KeyObservation",
      "type": "object"
    },
    "Recommendation": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "related_learning_objective": {
          "title": "Related Learning Objective",
          "type": "string"
        }
      },
      "required": [
        "text",
        "related_learning_objective"
      ],
      "title": "Recommendation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical AAR output (spec 6.4).",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AARStatus"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "executive_summary": {
      "title": "Executive Summary",
      "type": "string"
    },
    "key_observations": {
      "items": {
        "$ref": "#/$defs/KeyObservation"
      },
      "title": "Key Observations",
      "type": "array"
    },
    "strengths": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Strengths",
      "type": "array"
    },
    "improvement_areas": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Improvement Areas",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "evidence_limitations": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Limitations",
      "type": "array"
    },
    "follow_up_scenario_brief": {
      "title": "Follow Up Scenario Brief",
      "type": "string"
    },
    "model_provider": {
      "title": "Model Provider",
      "type": "string"
    },
    "model_name": {
      "title": "Model Name",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "reviewed_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed By"
    }
  },
  "required": [
    "id",
    "session_id",
    "status",
    "title",
    "executive_summary",
    "key_observations",
    "strengths",
    "improvement_areas",
    "recommendations",
    "evidence_limitations",
    "follow_up_scenario_brief",
    "model_provider",
    "model_name",
    "prompt_version",
    "created_at"
  ],
  "title": "AARReport",
  "type": "object"
}
