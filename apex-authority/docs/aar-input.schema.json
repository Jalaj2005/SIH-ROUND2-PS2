{
  "$defs": {
    "AARDecision": {
      "properties": {
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "decision_key": {
          "title": "Decision Key",
          "type": "string"
        },
        "role_id": {
          "title": "Role Id",
          "type": "string"
        },
        "selected_option_id": {
          "title": "Selected Option Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        },
        "available_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Available Evidence Refs",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_breakdown": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Score Breakdown",
          "type": "object"
        }
      },
      "required": [
        "decision_id",
        "decision_key",
        "role_id",
        "selected_option_id",
        "submitted_at"
      ],
      "title": "AARDecision",
      "type": "object"
    },
    "AAREvent": {
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "sequence_no": {
          "title": "Sequence No",
          "type": "integer"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "scenario_offset_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Offset Seconds"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "sequence_no",
        "event_type",
        "occurred_at"
      ],
      "title": "AAREvent",
      "type": "object"
    },
    "AARParticipant": {
      "properties": {
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "role_id": {
          "title": "Role Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "display_name",
        "role_id"
      ],
      "title": "AARParticipant",
      "type": "object"
    },
    "AARScenarioRef": {
      "properties": {
        "scenario_id": {
          "format": "uuid",
          "title": "Scenario Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "learning_objectives": {
          "items": {
            "type": "string"
          },
          "title": "Learning Objectives",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "title",
        "learning_objectives"
      ],
      "title": "AARScenarioRef",
      "type": "object"
    },
    "AARSessionSummary": {
      "properties": {
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended At"
        },
        "participant_count": {
          "title": "Participant Count",
          "type": "integer"
        }
      },
      "required": [
        "started_at",
        "ended_at",
        "participant_count"
      ],
      "title": "AARSessionSummary",
      "type": "object"
    }
  },
  "properties": {
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/AARScenarioRef"
    },
    "session_summary": {
      "$ref": "#/$defs/AARSessionSummary"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/AARParticipant"
      },
      "title": "Participants",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metrics",
      "type": "object"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/AARDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/AAREvent"
      },
      "title": "Events",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "scenario",
    "session_summary"
  ],
  "title": "AARInput",
  "type": "object"
}
