    },
    "duration_minutes": {
      "title": "Duration Minutes",
      "type": "integer"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/Role"
      },
      "title": "Roles",
      "type": "array"
    },
    "initial_reports": {
