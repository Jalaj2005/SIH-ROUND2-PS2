  "required": [
    "id",
    "title",
    "description",
    "domain",
    "learning_objectives",
    "difficulty",
    "duration_minutes",
    "roles",
    "initial_reports",
    "events",
    "decision_points",
    "instructor_notes",
    "status"
  ],
  "title": "Scenario",
  "type": "object"
}
