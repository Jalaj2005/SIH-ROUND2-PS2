        "$ref": "#/$defs/ScenarioEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "decision_points": {
      "items": {
        "$ref": "#/$defs/DecisionPoint"
      },
      "title": "Decision Points",
      "type": "array"
    },
    "instructor_notes": {
      "items": {
        "type": "string"
      },
      "title": "Instructor Notes",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ScenarioStatus"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
