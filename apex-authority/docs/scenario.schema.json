          "title": "Decision Key",
          "type": "string"
        },
        "offset_seconds": {
          "title": "Offset Seconds",
          "type": "integer"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "visible_to_roles": {
          "items": {
            "type": "string"
          },
