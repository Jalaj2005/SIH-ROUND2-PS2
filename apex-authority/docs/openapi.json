      "Classification": {
        "type": "string",
        "enum": [
          "fact",
          "interpretation",
          "recommendation"
        ],
        "title": "Classification"
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "title": "Confidence"
      },
      "DecisionOption": {
        "properties": {
          "option_id": {
            "type": "string",
            "title": "Option Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "option_id",
          "label"
        ],
        "title": "DecisionOption"
      },
