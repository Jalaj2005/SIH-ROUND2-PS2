  "components": {
    "schemas": {
      "AARCreateRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "include_individual_feedback": {
            "type": "boolean",
            "title": "Include Individual Feedback",
            "default": false
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "title": "Language",
            "default": "en"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "AARCreateRequest"
      },
      "AARCreateResponse": {
        "properties": {
          "aar_id": {
            "type": "string",
            "format": "uuid",
            "title": "Aar Id"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/AARStatus"
          },
          "report": {
            "$ref": "#/components/schemas/AARReport"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "version_count": {
            "type": "integer",
            "title": "Version Count",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "aar_id",
          "session_id",
          "status",
          "report"
        ],
        "title": "AARCreateResponse"
      },
      "AARReport": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/AARStatus"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "executive_summary": {
            "type": "string",
            "title": "Executive Summary"
          },
          "key_observations": {
            "items": {
              "$ref": "#/components/schemas/KeyObservation"
            },
            "type": "array",
            "title": "Key Observations"
          },
          "strengths": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Strengths"
          },
          "improvement_areas": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Improvement Areas"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "evidence_limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Limitations"
          },
          "follow_up_scenario_brief": {
            "type": "string",
            "title": "Follow Up Scenario Brief"
          },
          "model_provider": {
            "type": "string",
            "title": "Model Provider"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          },
          "reviewed_by": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed By"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "session_id",
          "status",
          "title",
          "executive_summary",
          "key_observations",
          "strengths",
          "improvement_areas",
          "recommendations",
          "evidence_limitations",
          "follow_up_scenario_brief",
          "model_provider",
          "model_name",
          "prompt_version",
          "created_at"
        ],
        "title": "AARReport",
        "description": "Canonical AAR output (spec 6.4)."
      },
      "AARStatus": {
        "type": "string",
        "enum": [
          "draft",
          "reviewed",
          "exported"
        ],
        "title": "AARStatus"
      },
      "AARUpdateRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "executive_summary": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Executive Summary"
          },
          "key_observations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/KeyObservation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key Observations"
          },
          "strengths": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Finding"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strengths"
          },
          "improvement_areas": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Finding"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Improvement Areas"
          },
          "recommendations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Recommendation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendations"
          },
          "evidence_limitations": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Limitations"
          },
          "follow_up_scenario_brief": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Follow Up Scenario Brief"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AARUpdateRequest",
        "description": "Instructor edits. Only narrative fields are editable; provenance/status/ids are not."
