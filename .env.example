# Copy to .env (never commit .env). All values below are prototype/dev defaults.
ENVIRONMENT=development            # development | test | production
DATABASE_URL=sqlite:///./aicte_ps4.db
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/aicte_ps4
SECRET_KEY=change-me-to-a-random-string-of-32-plus-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Prototype authentication only (seeded demo users, no passwords). Not production auth.
DEMO_AUTH_ENABLED=true
CORS_ORIGINS=http://localhost:5173
